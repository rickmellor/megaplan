# MegaPlan service config — copy to .env next to docker-compose.yml on the NAS.
MEGAPLAN_DATA_PATH=/data
MEGAPLAN_GIT_NAME=megaplan
MEGAPLAN_GIT_EMAIL=megaplan@nas
MEGAPLAN_AUTO_DONE=1
# Public base URL of THIS service — used to build the `url` returned by `render`.
# Set it to how clients reach the box, not localhost, or report links will be wrong.
MEGAPLAN_PUBLIC_URL=http://192.168.1.134:8932

# Astoria memory service (LAN) used for related-plan / context retrieval
MEGAPLAN_MEMORY_URL=http://192.168.1.134:8933/recall
MEGAPLAN_MEMORY_USER=rick
#MEGAPLAN_MEMORY_TOKEN=
#MEGAPLAN_MEMORY_CLIENT=megaplan      # identifies this service to Astoria

# Off-site backup: a share that a cloud-sync task mirrors (bundles are copied here)
#MEGAPLAN_OFFSITE_DIR=/volume1/megaplan-backups
